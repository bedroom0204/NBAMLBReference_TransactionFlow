{
  "manifest_version": 3,
  "name": "Sports Reference Trade Visualizer",
  "version": "1.0.1",
  "description": "Transform complex NBA & MLB transaction text on Sports Reference into intuitive single-edge visual trade flows and career timelines.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Sports Trade Visualizer"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.basketball-reference.com/players/*",
        "*://*.baseball-reference.com/players/*",
        "*://*.pro-football-reference.com/players/*",
        "*://*.hockey-reference.com/players/*"
      ],
      "js": [
        "team-colors.js",
        "parser.js",
        "visualizer.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ]
}
